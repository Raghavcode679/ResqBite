# Groq API key — primary engine for the AI site assistant (https://console.groq.com/keys)
GROQ_API_KEY="MY_GROQ_API_KEY"

# Gemini API key — engine for structured analysis features (https://aistudio.google.com/apikey)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server port
PORT=3000

# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.8-flash
